# Postgres connection string (Supabase: prefer the transaction pooler on port 6543)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres

# Optional: connections per process (default 5)
#DATABASE_POOL_MAX=5

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash.
# On Vercel leave this unset (or use your real domain); localhost values are ignored there.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Vercel Blob read/write token (Vercel → Storage → Blob). When set, media uploads are stored
# in Vercel Blob instead of the local public/media folder. Required for uploads on Vercel.
#BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx_yyy

# Email for order notifications (any SMTP provider). Without SMTP_HOST, emails are only logged.
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASS=
#SMTP_FROM=orders@example.com
